# Local .terraform directories
**/.terraform/*

# Exclude Terraform state files
*.tfstate
*.tfstate.*

# Exclude Terraform plan files
*.tfplan
*tfplan*

# Ignore crash logs
crash.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore Lock
.terraform.lock.hcl

# Ignore lock info generated by old Terraform versions
.terraform.tfstate.lock.info

# Ignore reference folder contents from repo root
/reference/